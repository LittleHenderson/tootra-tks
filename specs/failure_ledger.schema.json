{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tks:failure-ledger",
  "title": "TKS Failure Ledger",
  "description": "Schema for RTTA-R failure tracking and rumination",
  "type": "object",
  "required": ["version", "threshold", "created_at", "updated_at", "records", "index"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "const": "1.0"
    },
    "threshold": {
      "type": "number",
      "description": "Impact threshold for prioritization",
      "minimum": 0,
      "maximum": 1,
      "default": 0.6
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of ledger creation"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "records": {
      "type": "object",
      "description": "Map of failure ID to FailureRecord",
      "additionalProperties": {
        "$ref": "#/$defs/FailureRecord"
      }
    },
    "index": {
      "type": "object",
      "description": "Status-based index for fast lookup",
      "required": ["unsolved", "solved", "retired"],
      "properties": {
        "unsolved": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of unsolved failures"
        },
        "solved": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of solved failures"
        },
        "retired": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of retired failures"
        }
      }
    }
  },
  "$defs": {
    "FailureRecord": {
      "type": "object",
      "required": [
        "id", "question_text", "expected", "model_answer", "status",
        "first_unmet_slot", "impact_score", "desire_level", "error_severity",
        "novelty_gap", "recency", "gist", "attempt_count", "rumination_cycles",
        "last_seen_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique failure identifier"
        },
        "question_text": {
          "type": "string",
          "description": "The question that caused failure"
        },
        "expected": {
          "type": "string",
          "description": "Expected answer"
        },
        "model_answer": {
          "type": "string",
          "description": "Model's incorrect answer"
        },
        "status": {
          "type": "string",
          "enum": ["unsolved", "solved", "retired"],
          "description": "Current status of the failure"
        },
        "first_unmet_slot": {
          "type": "string",
          "enum": ["1D", "2W", "3P", "4D", "5W", "6P", "7D", "8W", "9P", "10D", "11W", "12P"],
          "description": "First NJT slot that failed"
        },
        "impact_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Noetic 4 (Vibration) based priority score"
        },
        "desire_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "4D desire accumulation with diminishing returns"
        },
        "error_severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Severity of the error (0.7 = unable, 1.0 = wrong)"
        },
        "novelty_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How novel/unknown the problem type is"
        },
        "recency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Recency weight (decays over time)"
        },
        "gist": {
          "$ref": "#/$defs/Gist"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of solve attempts"
        },
        "rumination_cycles": {
          "type": "integer",
          "minimum": 0,
          "description": "Total rumination cycles spent"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last time this failure was encountered"
        },
        "operator_missing": {
          "type": "string",
          "description": "Operator needed to solve (e.g., OP-SEQ-UNKNOWN)"
        },
        "last_ruminated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last rumination timestamp"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when solved"
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "description": "List of attempted hypotheses"
        }
      }
    },
    "Gist": {
      "type": "object",
      "required": ["type", "signature", "slot_block"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Problem type (sequence, syllogism, linear_system, etc.)"
        },
        "signature": {
          "type": "string",
          "description": "Minimal pattern signature for later solving"
        },
        "slot_block": {
          "type": "string",
          "enum": ["1D", "2W", "3P", "4D", "5W", "6P", "7D", "8W", "9P", "10D", "11W", "12P"],
          "description": "Primary slot where failure occurs"
        },
        "missing_operator": {
          "type": "string",
          "description": "Proposed operator name"
        },
        "pattern_hint": {
          "type": "string",
          "description": "Pattern hint (fibonacci_like, prime_sequence, etc.)"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes"
        }
      }
    },
    "Hypothesis": {
      "type": "object",
      "required": ["label", "status"],
      "properties": {
        "label": {
          "type": "string",
          "description": "Operator or strategy label"
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "validated", "rejected"],
          "description": "Hypothesis status"
        },
        "notes": {
          "type": "string",
          "description": "Validation notes"
        }
      }
    }
  }
}
